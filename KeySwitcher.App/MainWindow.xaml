<Window x:Class="KeySwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeySwitcher by koda" Width="940" Height="720" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition/><RowDefinition Height="56"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#10141C" BorderBrush="#252B39" BorderThickness="0,0,0,1">
      <Grid Margin="28,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Border Width="52" Height="52" CornerRadius="15" Background="{StaticResource Accent}" Margin="0,0,16,0">
            <TextBlock Text="K" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="KeySwitcher" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="РАСКЛАДКА · ГОЛОС · ПЕРЕВОД" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/></StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Background="#16251F" CornerRadius="12" Padding="15,9" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#43E39B" Margin="0,0,8,0"/><TextBlock Text="РАБОТАЕТ ЛОКАЛЬНО" FontWeight="SemiBold" FontSize="11"/></StackPanel></Border>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="24,20" Background="Transparent" BorderThickness="0">
      <TabItem Header="Главное">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10,20,10,0">
          <GroupBox Header="ИСПРАВЛЕНИЕ РАСКЛАДКИ"><StackPanel>
            <CheckBox Content="Автоматически исправлять слова на Space, Enter и Tab" IsChecked="{Binding Settings.AutoCorrect}"/>
            <CheckBox Content="Показывать системные уведомления" IsChecked="{Binding Settings.ShowNotifications}"/>
            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Исправить последнее слово" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding Settings.CorrectHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Включить/выключить автоматику" Foreground="{StaticResource Muted}"/><TextBox Text="Ctrl+Alt+K" IsReadOnly="True" Margin="0,6,0,0"/></StackPanel>
            </Grid>
          </StackPanel></GroupBox>
          <GroupBox Header="СИСТЕМА"><StackPanel><CheckBox Content="Запускать KeySwitcher вместе с Windows" IsChecked="{Binding Settings.StartWithWindows}"/><TextBlock Text="Введённый текст не сохраняется. В памяти находится только текущее слово." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></GroupBox>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="Голос Whisper">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10,20,10,0">
          <GroupBox Header="ЛОКАЛЬНОЕ РАСПОЗНАВАНИЕ"><StackPanel>
            <TextBlock Text="Нажмите хоткей, продиктуйте текст и нажмите его ещё раз. Результат появится в активном поле." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,15"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="Модель"/><ComboBox ItemsSource="{Binding WhisperModels}" SelectedItem="{Binding Settings.WhisperModel}" Margin="0,7,0,0"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Язык"/><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Settings.VoiceLanguage}" Margin="0,7,0,0"/></StackPanel>
            </Grid>
            <TextBlock Text="Горячая клавиша" Margin="0,17,0,6"/><TextBox Text="{Binding Settings.VoiceHotkey, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox Content="Автоматическая пунктуация Whisper" IsChecked="{Binding Settings.AutoPunctuation}"/>
            <Border Background="#131D2A" CornerRadius="9" Padding="12" Margin="0,12,0,0"><TextBlock Text="Модель скачивается один раз при первом запуске диктовки: Tiny ≈ 75 МБ, Base ≈ 142 МБ, Small ≈ 466 МБ. Для вашего ноутбука оптимально Base или Small." TextWrapping="Wrap" Foreground="#B7C6E0"/></Border>
          </StackPanel></GroupBox>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="Перевод">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10,20,10,0">
          <GroupBox Header="ПЕРЕВОД ВЫДЕЛЕННОГО ТЕКСТА"><StackPanel>
            <TextBlock Text="Выделите текст в любом приложении и нажмите хоткей. Направление RU ↔ EN определяется автоматически." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,15"/>
            <TextBlock Text="Горячая клавиша"/><TextBox Text="{Binding Settings.TranslateHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
            <TextBlock Text="Адрес LibreTranslate"/><TextBox Text="{Binding Settings.TranslationEndpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,14"/>
            <TextBlock Text="API-ключ (для локального сервера не нужен)"/><TextBox Text="{Binding Settings.TranslationApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
            <Border Background="#201A12" CornerRadius="9" Padding="12" Margin="0,15,0,0"><TextBlock Text="По умолчанию используется локальный адрес 127.0.0.1:5000. Пока локальный LibreTranslate не запущен, перевод будет недоступен — ваш текст не будет автоматически отправлен на чужой сервер." TextWrapping="Wrap" Foreground="#F2CE91"/></Border>
          </StackPanel></GroupBox>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="Сниппеты">
        <Grid Margin="10,20,10,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <GroupBox Header="АВТОЗАМЕНА"><StackPanel><TextBlock Text="Одна запись на строку: сокращение=полный текст" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/><TextBox Text="{Binding Settings.SnippetsText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="340"/></StackPanel></GroupBox>
          <StackPanel Grid.Column="2"><GroupBox Header="НЕ ПЕРЕКЛЮЧАТЬ"><TextBox Text="{Binding Settings.IgnoredWordsText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" MinHeight="145" VerticalScrollBarVisibility="Auto"/></GroupBox><GroupBox Header="ВСЕГДА ПЕРЕКЛЮЧАТЬ"><TextBox Text="{Binding Settings.ForceSwapWordsText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" MinHeight="145" VerticalScrollBarVisibility="Auto"/></GroupBox></StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Приложения">
        <StackPanel Margin="10,20,10,0"><GroupBox Header="НЕ ОБРАБАТЫВАТЬ В ЭТИХ ПРИЛОЖЕНИЯХ"><StackPanel><TextBlock Text="Имя процесса .exe, одна программа на строку. Парольные менеджеры и удалённый рабочий стол добавлены по умолчанию." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBox Text="{Binding Settings.ExcludedAppsText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" MinHeight="320" VerticalScrollBarVisibility="Auto"/></StackPanel></GroupBox></StackPanel>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#10141C" BorderBrush="#252B39" BorderThickness="0,1,0,0">
      <Grid Margin="24,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Открыть папку данных" Command="{Binding OpenDataCommand}" Background="#283043"/><Button Content="Сохранить настройки" Command="{Binding SaveCommand}"/></StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
